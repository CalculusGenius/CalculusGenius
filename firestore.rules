rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {

        match /premiumRequests/{userId} {

            allow create:
                if request.auth != null
                && request.auth.uid == userId;

            allow read:
                if request.auth != null
                && (
                    request.auth.uid == userId
                    ||
                    request.auth.token.email == 'calculusgenius67@gmail.com'
                );

            allow update:
                if request.auth != null
                && request.auth.token.email == 'calculusgenius67@gmail.com';

            allow delete:
                if false;
        }


        match /premiumAccess/{userId} {

            allow read:
                if request.auth != null
                && (
                    request.auth.uid == userId
                    ||
                    request.auth.token.email == 'calculusgenius67@gmail.com'
                );

            allow create, update:
                if request.auth != null
                && request.auth.token.email == 'calculusgenius67@gmail.com';

            allow delete:
                if false;
        }

    }
}
