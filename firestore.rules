rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {

        // =========================================
        // PRIVATE USER PROFILES
        // =========================================

        match /users/{userId} {

            allow read, create, update:
                if request.auth != null
                && request.auth.uid == userId;

            allow delete:
                if false;
        }


        // =========================================
        // PREMIUM REQUESTS
        // =========================================

        match /premiumRequests/{userId} {

            // A signed-in user may create/update ONLY
            // their own premium request.
            allow create, update:
                if request.auth != null
                && request.auth.uid == userId;

            // Users may read their own request.
            // The administrator may read any request.
            allow read:
                if request.auth != null
                && (
                    request.auth.uid == userId
                    ||
                    request.auth.token.email == 'calculusgenius67@gmail.com'
                );

            allow delete:
                if false;
        }


        // =========================================
        // PREMIUM ACCESS
        // =========================================

        match /premiumAccess/{userId} {

            // A user may check only their own approval.
            // The administrator may read any approval.
            allow read:
                if request.auth != null
                && (
                    request.auth.uid == userId
                    ||
                    request.auth.token.email == 'calculusgenius67@gmail.com'
                );

            // Only the administrator can grant/revoke
            // premium access.
            allow create, update:
                if request.auth != null
                && request.auth.token.email == 'calculusgenius67@gmail.com';

            allow delete:
                if false;
        }


        // =========================================
        // DEFAULT DENY
        // =========================================

        match /{document=**} {

            allow read, write:
                if false;
        }

    }
}
